# Skeleton .gitignore - ignore scratch, keep the .sys corpus you collect yourself.
downloads/*
!downloads/README.md
!downloads/.gitkeep
_collected*/**/packages/
_collected*/**/extract/
_collected*/**/work/
_collected*/**/manual/
_collected*/**/staging/
_scratch/
*.log
!poc/dynamic/results/**
*.tmp
Thumbs.db
desktop.ini

# VM guest credentials stay local and out of git.
VM_ACCESS.md
